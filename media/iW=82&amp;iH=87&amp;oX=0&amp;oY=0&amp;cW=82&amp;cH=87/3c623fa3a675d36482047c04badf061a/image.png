iW=238&amp;iH=476&amp;oX=1&amp;oY=0&amp;cW=237&amp;cH=476/6ae77adbf1a1b2cc7990c0e3f9c0993a/image.png" loading="lazy" alt="" title="" draggable="false"></picture></div></div><div id="" class="brz-css-d-1wonu5h brz-css-r-18yxudy brz-css-1sjyapy brz-wrapper"><div class="brz-spacer brz-css-d-d4vxpd brz-css-f9qxf4"></div></div></div></div><div class="brz-columns brz-css-d-j7y22h brz-css-ndjcsh" data-brz-custom-id="iwasiopqbfrwylsujmoevmjpxxwbiifeqhld"><div class="brz-column__items brz-css-d-v5w42e brz-css-ykvbv5"><div id="" class="brz-css-d-1wonu5h brz-css-10dkgck brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-89ktpf" data-brz-custom-id="weakauiyrncjqrqooiemkentvgcmqdunxhty"><div data-brz-translate-text="1"><h2 class="brz-tp-heading2 brz-css-1cucf8n"><span class="brz-cp-color2">Always talk to the best voice assistants available.</span></h2></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-r-18yxudy brz-css-1e7ytrz brz-wrapper"><div class="brz-spacer brz-css-d-d4vxpd brz-css-1hxn2er"></div></div><div id="" class="brz-css-d-1wonu5h brz-css-1tbx6t brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-1396kjq" data-brz-custom-id="ygqqhwbpkkumvylpnjhlyqembaacukiytdjw"><div data-brz-translate-text="1"><p class="brz-text-lg-justify brz-tp-lg-paragraph brz-css-19u4agy" data-uniq-id="nrafz" data-generated-css="brz-css-tubau"><strong class="brz-cp-color7">We develop technologies for voice AI interoperability based on Noam Chomsky's theory of hard-wired and universal language in human intelligence. </strong><span class="brz-cp-color7">The project launched in 2018 by initiating an ISO-compatible standard for NLP API harmonization. We are currently raising funds on </span><a class="link--external brz-cp-color7" href="http://republic.co/whoelse-ai" data-brz-link-type="external">Republic</a><span class="brz-cp-color7">. Learn more about the </span><a class="link--external brz-cp-color7" href="/idea" data-brz-link-type="external">idea</a><span class="brz-cp-color7">, our forthcoming </span><a class="link--external brz-cp-color7" href="/browser" data-brz-link-type="external">voice browser</a><span class="brz-cp-color7">, </span><a class="link--external brz-cp-color7" href="/solutions" data-brz-link-type="external">industry solutions</a><span class="brz-cp-color7">, and how to </span><a class="link--external brz-cp-color7" href="/contact" data-brz-link-type="external">get involved</a><span class="brz-cp-color7">.</span></p></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-r-18yxudy brz-css-10zrhu4 brz-wrapper"><div class="brz-spacer brz-css-d-d4vxpd brz-css-15bz1pd"></div></div><div id="" class="brz-css-d-1wonu5h brz-css-yc6a6r brz-wrapper"><div data-brz-form-version="2" class="brz-forms2 brz-css-d-17ed1lg brz-css-1xyew8b" data-brz-custom-id="mqxemnykhdvfxqqdhslymxvmqpkrnwssypkj"><form class="brz-form brz-d-xs-flex brz-flex-xs-wrap" novalidate="" action="https://lead.formsender.site/form/submit" data-brz-form-id="mqxemnykhdvfxqqdhslymxvmqpkrnwssypkj" data-brz-project-id="6285519" data-brz-success="<center><font face=&quot;Lato, Helvetica, Verdana&quot;>We will be in touch shortly!</font></center>" data-brz-error="Your email was not sent" data-brz-redirect="" data-brz-empty="Please fill in the required fields" data-brz-form-type="default" data-brz-translatable-default-success="Your email was sent successfully" data-brz-translatable-default-error="Your email was not sent" data-brz-translatable-default-empty="Please fill in the required fields" data-brz-translatable-default-invalid="Please check your entry and try again" data-brz-translatable-default-invalid-email="Please enter a valid email address (e.g., name@example.com)"><div data-brz-translate-text="1" class="brz-forms2__item brz-css-d-4uyhnf brz-css-1t1eyuv brz-css-d-aus8tv brz-css-10ufhlt"><input type="email" id="pHtJxpkhsLyN_i7a98909aac895b7353b9" name="vryozqdsxxurzjuwdzptiowvfsmyvzekzvkb" placeholder="name@domain.com" required="" pattern="%5E((%5B%5E%3C%3E%5C(%5C)%5C%5B%5C%5D%5C%5C.,;:%5Cs@%22%5D+(%5C.%5B%5E%3C%3E%5C(%5C)%5C%5B%5C%5D%5C%5C.,;:%5Cs@%22%5D+)*)%7C(%22.+%22))@((%5C%5B%5B0-9%5D%7B1,3%7D%5C.%5B0-9%5D%7B1,3%7D%5C.%5B0-9%5D%7B1,3%7D%5C.%5B0-9%5D%7B1,3%7D%5C%5D)%7C((%5Ba-zA-Z%5C-0-9%5D+%5C.)+%5Ba-zA-Z%5D%7B2,%7D))$" data-brz-type="Email" data-brz-label="name@domain.com" data-brz-placeholder="name@domain.com" maxlength="255" class="brz-input brz-forms2__field brz-forms2__field-email" value=""></div><div class="brz-forms2 brz-forms2__item brz-forms2__item-button" data-brz-custom-id="mqxemnykhdvfxqqdhslymxvmqpkrnwssypkj"><button class="brz-btn brz-btn-submit brz-css-d-1wywugq brz-css-p1izvh" data-brz-custom-id="hguvsclmlbvjhatsbdamlgjddchbkyxfchjw"><svg class="brz-icon-svg brz-css-d-o4rfik brz-css-1uuzvcq"><use href="https://www.whoelse.ai/icon/6285519/outline/tail-right.svg#nc_icon"></use></svg><span data-brz-translate-text="1" class="brz-span brz-text__editor">Request Invite</span></button><svg class="brz-icon-svg brz-form-spinner brz-invisible brz-ed-animated--spin"><use href="https://www.whoelse.ai/icon/6285519/glyph/circle-02.svg#nc_icon"></use></svg></div><div class="brz-forms2__messages brz-css-d-qyp96y"></div><div class="brz-g-recaptcha" data-sitekey="" data-size="invisible" data-callback="brzFormV2Captcha"></div></form></div></div></div></div></div></div></div></div></section>
    <section id="nessiybvecdryjfkrfzphesfcxxpssshluxx_nessiybvecdryjfkrfzphesfcxxpssshluxx" class="brz-section brz-css-d-ynf0il brz-css-vtcxxe"><div class="brz-section__content brz-section--boxed brz-css-d-oh3bvl brz-css-1xxjs25" data-brz-custom-id="wtmqltvduvqhwyidcritoukgelqccytsnkza"><div class="brz-bg"><div class="brz-bg-color"></div></div><div class="brz-container brz-css-d-x9rvyp brz-css-zpm2ly"><div class="brz-row__container brz-css-d-w3a52u brz-css-fqaxva" data-brz-custom-id="ghsvtalqzuysydmqfrtwayszretxelcrtrkd"><div class="brz-row brz-css-d-1n95ksq brz-css-r-1xc399q brz-css-zcq97d"><div class="brz-columns brz-css-d-j7y22h brz-css-17yxtjh" data-brz-custom-id="wcbtjphhstgeqfidjlgdpetsbydyilofslic"><div class="brz-column__items brz-css-d-v5w42e brz-css-u1q9o4"><div id="" class="brz-css-d-1wonu5h brz-css-44d8p8 brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-o9uoe2" data-brz-custom-id="awvszmoaxwpnjshtotdudklksskbgdmzybkg"><div data-brz-translate-text="1"><h1 class="brz-tp-lg-heading2 brz-tp-sm-heading1 brz-tp-xs-heading1 brz-css-12o2w0p"><span class="brz-cp-color2">Let's make AI talk to each other!</span></h1></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-r-18yxudy brz-css-wr6euw brz-wrapper"><div class="brz-spacer brz-css-d-d4vxpd brz-css-7wo6ri"></div></div><div id="" class="brz-css-d-1wonu5h brz-css-zjxr5p brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-1qsykjh" data-brz-custom-id="zducvaclpukhtwvyiefdwigtkdlxcmbenabf"><div data-brz-translate-text="1"><p class="brz-tp-lg-subtitle brz-text-lg-justify brz-css-3yua9a" data-uniq-id="teyhb" data-generated-css="brz-css-mozhl"><span class="brz-cp-color7">We reduce bias in natural language processing (NLP) AI R&amp;D and use case implementation. </span><strong class="brz-cp-color7">Our API makes voice AI interoperable by providing a simplified grammar and vocabulary to store the 200 most common intents in human language.</strong><span class="brz-cp-color7"> Voice commands become this way tradable. If an AI can't respond to a user, it can lookup other voice assistants using our protocol.</span></p></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-r-18yxudy brz-css-1n50a4q brz-wrapper"><div class="brz-spacer brz-css-d-d4vxpd brz-css-j0eyi4"></div></div><div class="brz-wrapper-clone brz-flex-xs-wrap brz-css-d-x0dcve brz-css-5vrd1l" data-brz-custom-id="ntzhejgttyjirfrhqlesdkplcbkjkxjcsgfw"><a class="brz-a brz-btn brz-css-d-1syz9i2 brz-css-l7ta21 brz-css-d-13c78oe brz-css-1eafjuu" target="_blank" rel="noopener noreferrer" href="https://docs.google.com/presentation/d/1d0R7UlVPzEgriccP1jjPQYF9ewkQyTkVV3XRz1dFVN8/export/pdf" data-brz-link-type="external" data-brz-custom-id="hohnjzmnqwqdficlwcouabjgiicqkwunorbr"><svg class="brz-icon-svg brz-css-d-o4rfik brz-css-1gzqryu"><use href="https://www.whoelse.ai/icon/6285519/outline/tail-right.svg#nc_icon"></use></svg><span data-brz-translate-text="1" class="brz-span brz-text__editor">Download Whitepaper&nbsp;</span></a></div></div></div><div class="brz-columns brz-css-d-j7y22h brz-css-r7id1d" data-brz-custom-id="drwihhhbdoqmuoazpedzrwdpedtjmaacewmu"><div class="brz-column__items brz-css-d-v5w42e brz-css-1yfdfxf"><div id="" class="brz-css-d-1wonu5h brz-css-uyt5ea brz-wrapper"><div class="brz-embed-code brz-css-d-12mke1z brz-css-6sus5y" data-brz-custom-id="wwebywznkylucisbwiwwrwhwlrtjtkzulbdi"><div class="brz-embed-content"><div><iframe src="https://docs.google.com/presentation/d/e/2PACX-1vTj2O1XywNGFyS7DF7T6dDKFjWmHdtcrhqAm92f62O1ERmmQ78TDub8J1CrR9zTyfLHCpTboD3gmSC2/embed?start=false&amp;loop=true&amp;delayms=60000" frameborder="0" width="100%" height="400" allowfullscreen="true" mozallowfullscreen="true" webkitallowfullscreen="true"></iframe></div></div></div></div></div></div></div></div></div></div></section>
    <section id="yxbjhnsttzklsxyjdttdlgqllkajmhpnprqb_yxbjhnsttzklsxyjdttdlgqllkajmhpnprqb" class="brz-section brz-css-d-ynf0il brz-css-frqnmz"><div class="brz-section__content brz-section--boxed brz-css-d-oh3bvl brz-css-cl1j64" data-brz-custom-id="znsiymlqhwpndftkqwdtyiinlifixlkvzdpy"><div class="brz-container brz-css-d-x9rvyp brz-css-1azvu0f"><div id="" class="brz-css-d-1wonu5h brz-css-1cb8zmw brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-4wii0d" data-brz-custom-id="ynhgbihkgsnmypzyackffjglrjchgfpapctb"><div data-brz-translate-text="1"><p class="brz-text-sm-center brz-bcp-color7 brz-text-lg-justify brz-tp-lg-heading2 brz-tp-sm-subtitle brz-tp-xs-subtitle brz-css-1f4im0y"><span class="brz-cp-color2">Every 1st contact will be a bot.</span><span class="brz-cp-color7"> </span></p></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-r-18yxudy brz-css-1p0hcxx brz-wrapper"><div class="brz-spacer brz-css-d-d4vxpd brz-css-yymdeq"></div></div><div id="" class="brz-css-d-1wonu5h brz-css-1ye75l3 brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-1i02k02" data-brz-custom-id="vygyhtwnibalkuxpfvdfjjrjamzolxeeuxmn"><div data-brz-translate-text="1"><p class="brz-text-lg-justify brz-bcp-color7 brz-text-sm-center brz-tp-xs-subtitle brz-tp-sm-subtitle brz-tp-lg-paragraph brz-css-148woe6"><span class="brz-cp-color7">Within 5 years voice AI e-commerce and customer service delivery will become the most important customer touchpoint. Get your business ready for voice AI using our solutions for AI e-commerce interoperability.</span></p></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-1am1ogb brz-wrapper"><div class="brz-image brz-css-d-1bmrslp brz-css-1q8g5bp" data-brz-custom-id="lrufaefvatqwqazbabkrugnuhkdegyfaufvl"><picture class="brz-picture brz-d-block brz-p-relative brz-css-d-lp1r5r brz-css-94n961"><source srcset="https://cloud-1de12d.becdn.net/media/iW=1123&amp;iH=366&amp;oX=0&amp;oY=0&amp;cW=1123&amp;cH=366/d03-Img-Lips/image.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=2246&amp;iH=732&amp;oX=0&amp;oY=0&amp;cW=2246&amp;cH=732/d03-Img-Lips/image.jpg 2x" media="(min-width: 992px)"><source srcset="https://cloud-1de12d.becdn.net/media/iW=768&amp;iH=250&amp;oX=0&amp;oY=0&amp;cW=768&amp;cH=250/d03-Img-Lips/image.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=1536&amp;iH=500&amp;oX=0&amp;oY=0&amp;cW=1536&amp;cH=500/d03-Img-Lips/image.jpg 2x" media="(min-width: 768px)"><img class="brz-img" srcset="https://cloud-1de12d.becdn.net/media/iW=602&amp;iH=196&amp;oX=86&amp;oY=0&amp;cW=430&amp;cH=196/d03-Img-Lips/image.jpg 1x, https://cloud-1de12d.becdn.net/media/iW=1204&amp;iH=392&amp;oX=172&amp;oY=0&amp;cW=860&amp;cH=392/d03-Img-Lips/image.jpg 2x" src="https://cloud-1de12d.becdn.net/media/iW=1123&amp;iH=366&amp;oX=0&amp;oY=0&amp;cW=1123&amp;cH=366/d03-Img-Lips/image.jpg" loading="lazy" alt="" title="" draggable="false"></picture></div></div><div class="brz-row__container brz-css-d-w3a52u brz-css-1lfmnl2" data-brz-custom-id="aarmelhhfoabjyqqmpmgxmcvhkfcptewmvqv"><div class="brz-row brz-css-d-1n95ksq brz-css-r-1xc399q brz-css-e0h9ls"><div class="brz-columns brz-css-d-j7y22h brz-css-2mvw40" data-brz-custom-id="cqqnidgyxilmdwbyabfovpwokxplppkubeyx"><div class="brz-column__items brz-css-d-v5w42e brz-css-18zuh7j"><div id="" class="brz-css-d-1wonu5h brz-css-dsvbkg brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-y8m258" data-brz-custom-id="wmyyowyzznommdhrztilvnukbkpgcvkvpike"><div data-brz-translate-text="1"><h4 class="brz-tp-lg-heading5 brz-tp-sm-heading4 brz-tp-xs-heading4 brz-css-1j1bnsi"><span class="brz-cp-color2">PRIVACY-BY-DESIGN</span></h4></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-sljz4q brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-dv76yw" data-brz-custom-id="mvqvnzgibtexcxjnolfgjyqsosckhvgstkrv"><div data-brz-translate-text="1"><p class="brz-text-lg-justify brz-tp-paragraph brz-css-19u4agy"><span class="brz-cp-color7">AI you can trust blindly! Our technologies protect biometric information in voice AI. </span></p></div></div></div></div></div><div class="brz-columns brz-css-d-j7y22h brz-css-18klijn" data-brz-custom-id="ursclguvdadcctkyhgmnddhmvqikuygcoojg"><div class="brz-column__items brz-css-d-v5w42e brz-css-197vgoe"><div id="" class="brz-css-d-1wonu5h brz-css-1itilp0 brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-59hddv" data-brz-custom-id="hmrpeznpfxljhebeuwklagrnemfbnbkviqos"><div data-brz-translate-text="1"><h4 class="brz-tp-lg-heading5 brz-tp-sm-heading4 brz-tp-xs-heading4 brz-css-1j1bnsi"><span class="brz-cp-color2">OPEN SOURCE</span></h4></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-1f4jxyf brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-n6a2lc" data-brz-custom-id="wcredindwlmpximrfjjkqmqiratfhyjnkyma"><div data-brz-translate-text="1"><p class="brz-text-lg-justify brz-tp-paragraph brz-css-19u4agy"><span class="brz-cp-color7">The source code is freely available and developed together with the academic community.</span></p></div></div></div></div></div><div class="brz-columns brz-css-d-j7y22h brz-css-15j2sw8" data-brz-custom-id="byvqbagikelayiasauttslysjzdzlbhrdfrf"><div class="brz-column__items brz-css-d-v5w42e brz-css-1wslcts"><div id="" class="brz-css-d-1wonu5h brz-css-1tfyynn brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-oq7cl2" data-brz-custom-id="gnqyyzbgkiiepfgknatlkntajirinleutocd"><div data-brz-translate-text="1"><h4 class="brz-tp-xs-heading4 brz-tp-sm-heading4 brz-tp-lg-heading5 brz-css-1j1bnsi"><span class="brz-cp-color2">VENDOR AGNOSTIC</span></h4></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-1ophhoh brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-md9fk6" data-brz-custom-id="doosofjyfvcgwynlvycvpgbqanjpzdxqencx"><div data-brz-translate-text="1"><p class="brz-text-lg-justify brz-tp-paragraph brz-css-19u4agy"><span class="brz-cp-color7">Our focus is language, not business models. The goal is to create the simplest grammar imaginable.</span></p></div></div></div></div></div><div class="brz-columns brz-css-d-j7y22h brz-css-15nu0vd" data-brz-custom-id="umdfxwbqcayxsdnewzntzfdyuwjvmsbmvdfo"><div class="brz-column__items brz-css-d-v5w42e brz-css-1i2iz1o"><div id="" class="brz-css-d-1wonu5h brz-css-odku9o brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-mue7fi" data-brz-custom-id="xijpinkkxmvdrxmkkrdiiqyxitwxozlzrdxg"><div data-brz-translate-text="1"><h4 class="brz-tp-lg-heading5 brz-tp-sm-heading4 brz-tp-xs-heading4 brz-css-1j1bnsi">UNIVERSAL GRAMMAR</h4></div></div></div><div id="" class="brz-css-d-1wonu5h brz-css-1v7mu26 brz-wrapper"><div class="brz-rich-text brz-rich-text__custom brz-css-d-1ehz5mr brz-css-lkesuh" data-brz-custom-id="uzphcdmqixednrvcmnxndpglmrmddmcsghlp"><div data-brz-translate-text="1"><p class="brz-tp-paragraph brz-text-lg-justify brz-css-19u4agy"><span class="brz-cp-color7">We use language hard-wired in communication as convention for the namespace protocol.</span></p></div></div></div></div></div></div></div></div></div></section>
    <section id="azfdlogyojbyvlvqpessvsoybehizwmbtsdk_azfdlogyojbyvlvqpessvsoybehizwmbtsdk" class="brz-section brz-css-d-ynf0il brz-css-mr5izc"><div class="brz-section__content brz-section--boxed brz-css-d-oh3bvl brz-css-16f3412" data-brz-custom-id="oufmgzlkeqxzzxeepxgyfeppwwkrgsrevakz"><div class="brz-container brz-css-d-x9rvyp brz-css-vb7aa"><div id="" class="brz-css-d-1wonu5h brz-css-r-18yxudy brz-css-kycefp brz-wrapper"><div class="brz-spacer brz-css-d-d4vxpd brz-css-yq4zuj"></div></div><div class="brz-row__container brz-css-d-w3a52u brz-css-jvbhv3" data-brz-custom-id="ejuabgwpglfzwtndcbjfvqvdvsmurfbfuszd"><div class="brz-row brz-css-d-1n95ksq brz-css-r-1xc399q brz-css-16ngyi8"><div class="brz-columns brz-css-d-j7y22h brz-css-1drpsst" data-brz-custom-id="ueuqajyfkxbchdnisjufihgvigtdavaddyjp"><div class="brz-column__items brz-css-d-v5w42e brz-css-9y6f7"><div id="" class="brz-css-d-1wonu5h brz-css-kdtywj brz-wrapper"><div class="brz-line brz-line-default brz-css-d-cci7wq brz-css-kiij8a" data-brz-custom-id="gtzqnrrevieytxpawqgtrqsrjrjukrrcqbuj"><hr class="brz-hr"></div></div></div></div></div></div></div></div></section>
